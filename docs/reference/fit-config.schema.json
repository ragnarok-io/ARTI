{
  "$id": "https://arti.local/schemas/fit-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "fit": {
      "additionalProperties": true,
      "properties": {
        "causal": {
          "type": "boolean"
        },
        "exclude_modules": {
          "items": {
            "type": "string"
          },
          "type": [
            "string",
            "array"
          ]
        },
        "objective": {
          "items": {
            "enum": [
              "preserve-output",
              "task-fit",
              "validate"
            ],
            "type": "string"
          },
          "type": [
            "string",
            "array"
          ]
        },
        "objectives": {
          "items": {
            "enum": [
              "preserve-output",
              "task-fit",
              "validate"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "phases": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "plugins": {
          "items": {
            "enum": [
              "recurrent",
              "timm",
              "torch",
              "transformers",
              "vision-cnn"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "enum": [
            "autoregressive-observer",
            "latent-adapt",
            "observer-phase",
            "virtual-recall"
          ],
          "type": "string"
        },
        "scale": {
          "enum": [
            "base",
            "large",
            "small",
            "tiny"
          ],
          "type": "string"
        },
        "target_modules": {
          "items": {
            "type": "string"
          },
          "type": [
            "string",
            "array"
          ]
        }
      },
      "type": "object"
    },
    "insertion": {
      "additionalProperties": false,
      "properties": {
        "boundary_mask_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "bridge_mode": {
          "enum": [
            "radial",
            "dense"
          ],
          "type": "string"
        },
        "every": {
          "minimum": 1,
          "type": "integer"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "type": [
            "string",
            "array"
          ]
        },
        "freeze_base": {
          "type": "boolean"
        },
        "identity_gate": {
          "type": "boolean"
        },
        "max_adapters": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_extra_params": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^([0-9]+(_[0-9]+)*|[0-9]+(\\.[0-9]+)?%)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "positions": {
          "oneOf": [
            {
              "enum": [
                "input",
                "output"
              ],
              "type": "string"
            },
            {
              "items": {
                "enum": [
                  "input",
                  "output"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "require_runtime_context": {
          "type": "boolean"
        },
        "scale_pattern": {
          "additionalProperties": {
            "enum": [
              "base",
              "large",
              "small",
              "tiny"
            ],
            "type": "string"
          },
          "type": "object"
        },
        "where": {
          "items": {
            "type": "string"
          },
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "zero_init_output": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "mechanism": {
      "additionalProperties": false,
      "not": {
        "properties": {
          "recall_bank_fraction": {
            "type": "number"
          },
          "recall_slots": {
            "type": "integer"
          }
        },
        "required": [
          "recall_bank_fraction",
          "recall_slots"
        ]
      },
      "properties": {
        "coord_dim": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "coord_frame_mode": {
          "enum": [
            "none",
            "paired_rotation",
            "operator_bank",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "hidden_multiplier": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "interface_slots": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "observer_phase": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "operator_count": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_activation": {
          "enum": [
            "half",
            "none",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "recall_bank_fraction": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "type": [
            "number",
            "null"
          ]
        },
        "recall_formula": {
          "description": "Explicit process-local Recall Formula provider ID. The host must register it before attachment or loading.",
          "type": [
            "string",
            "null"
          ]
        },
        "recall_group_size": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_group_topk": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_key_dim": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_min_steps": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_recognition_mode": {
          "enum": [
            "none",
            "explicit",
            "alignment",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "recall_routing": {
          "enum": [
            "dense",
            "grouped",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "recall_slots": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_steps": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recall_tolerance": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "recall_value_composition": {
          "enum": [
            "single",
            "product",
            "state",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "virtual_recall": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "objective": {
      "items": {
        "enum": [
          "preserve-output",
          "task-fit",
          "validate"
        ],
        "type": "string"
      },
      "type": [
        "string",
        "array"
      ]
    },
    "objectives": {
      "items": {
        "enum": [
          "preserve-output",
          "task-fit",
          "validate"
        ],
        "type": "string"
      },
      "type": [
        "string",
        "array"
      ]
    },
    "phases": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "plugins": {
      "items": {
        "enum": [
          "recurrent",
          "timm",
          "torch",
          "transformers",
          "vision-cnn"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "enum": [
        "autoregressive-observer",
        "latent-adapt",
        "observer-phase",
        "virtual-recall"
      ],
      "type": "string"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "causal": {
          "type": "boolean"
        },
        "coord_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_operators_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "mask_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "observer_coord_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "scale": {
      "enum": [
        "base",
        "large",
        "small",
        "tiny"
      ],
      "type": "string"
    }
  },
  "title": "ARTI Fit Project Config",
  "type": "object"
}
